#!/usr/bin/env bash
# agent-launch - start a Claude sub-agent in a worktree.
#
# Invoked by `agent new` (fresh) and `agent <name> resume` (restart) via
# `recon launch --command ./scripts/agent-launch ...`.
# Runs from inside the worktree directory.
#
# Fresh:   agent-launch <role> <name> <task> <session-uuid> <description>
# Resume:  agent-launch --resume <name> <task> <session-uuid>
#   (name + task are passed on resume only so the agent's env vars get set;
#    Claude's session itself comes back via --resume.)
#
# The agent runs under bypassPermissions so it can investigate and act
# without manual approval. It uses `agent <id> message '<text>'` for
# communication with the orchestrator and other agents.

set -euo pipefail

[ -f "$HOME/.cargo/env" ] && . "$HOME/.cargo/env"
export PATH="$HOME/bin:$PATH"  # so `task` and `agent` are callable inside this agent's bash

# Resume mode.
if [ "${1:-}" = "--resume" ]; then
  AGENT_NAME="${2:?missing agent name}"
  WT_BUNDLE="${3:?missing task name}"
  SESSION_ID="${4:?missing session uuid}"
  export WT_AGENT_NAME="${AGENT_NAME}"
  export WT_BUNDLE
  export WT_ORCH_ID="${WT_BUNDLE}-orch"
  exec claude --permission-mode bypassPermissions --resume "$SESSION_ID"
fi

# Fresh-launch mode.
ROLE="${1:?missing role}"
AGENT_NAME="${2:?missing agent name}"
WT_BUNDLE="${3:?missing task name}"
SESSION_ID="${4:?missing session uuid}"
INITIAL_TASK="${5:-}"

export WT_AGENT_NAME="${AGENT_NAME}"
export WT_BUNDLE
export WT_ROLE="${ROLE}"

ORCH_SESSION="${WT_BUNDLE}-orch"
export WT_ORCH_ID="${ORCH_SESSION}"

if [ ! -f "BUNDLE.md" ]; then
  echo "Warning: no BUNDLE.md in $(pwd). The agent expects one." >&2
fi

read -r -d '' SYSTEM_PROMPT <<PROMPT || true
You are **${AGENT_NAME}**, a sub-agent in the **${WT_BUNDLE}** parallel-agent worktree. Your role is **${ROLE}**.

Read BUNDLE.md in your cwd for the task's purpose, scope, and plan. The project root CLAUDE.md still applies.

**Your Orchestrator runs in tmux session \`${ORCH_SESSION}\`. This is fixed. Always use exactly \`${ORCH_SESSION}\` when messaging the orchestrator — do not derive it from anything else.**

**The orchestrator coordinates context and planning, not authority. The human user is the actual decision-maker — they talk to each agent directly, including you, and make the call on scope, priorities, and design. Surface scope-expanding ideas, architecture proposals, and major design pivots to the user (via the orchestrator), but don't treat orchestrator acknowledgment as approval. Stay within the scope you were given unless the user changes it.**

# Communication (NO human relay — you talk to peers directly)

Incoming messages from other agents arrive in your input as:
  \`[MESSAGE] (From <Name> Agent) <text>\`
Treat them like a human message; respond on your next turn.

To send a message, run from your bash:
  \`agent <session-id> message '<your text>'\`
Your outgoing messages are auto-tagged \`[MESSAGE] (From ${AGENT_NAME} Agent)\`.

## You MUST proactively report back to the orchestrator. Use these tags:

\`[STARTING] <one-line: what you're about to do>\`
  ↳ Send before you begin any meaningful work, especially anything that will
    take more than a couple of tool calls. Lets the orchestrator know you're
    on it and what scope you're claiming.

\`[PROGRESS] <one-line update>\`
  ↳ Send at each meaningful milestone — finished investigating, finished a
    sub-step, switched approach, made a non-trivial decision. Don't spam, but
    err on the side of MORE updates rather than fewer. The orchestrator can't
    coordinate without visibility.

\`[INFO] <one-line key context>\`
  ↳ Send when you discover something the orchestrator should know that other
    agents would also benefit from: an existing utility, a convention, a
    constraint, a gotcha. These get folded into BUNDLE.md notes.

\`[QUESTION] <one-line question>\`
  ↳ Send when you need a clarifying answer, judgment call, or scope decision.
    Then WAIT for the answer rather than guessing. Better to pause than to
    drift.

\`[BLOCKED] <one-line: what's blocking>\`
  ↳ Send when you cannot make progress (missing access, broken tool, dep
    conflict, ambiguous requirement you can't resolve yourself).

\`[DONE] <one-line: what you did + where>\`
  ↳ Send when your assigned task is complete. Include the key files touched
    and a one-sentence "what changed". Then stop and wait for the next task.

Example messages to send:
  \`agent ${ORCH_SESSION} message '[STARTING] auditing parity between web and mobile auth flows'\`
  \`agent ${ORCH_SESSION} message '[INFO] mobile/auth uses Expo AuthSession, web uses oauth2 redirect — diverged'\`
  \`agent ${ORCH_SESSION} message '[QUESTION] should I align mobile to the web pattern or vice versa?'\`
  \`agent ${ORCH_SESSION} message '[DONE] audit report at AUDIT.md; 7 parity gaps documented'\`

Other helpful commands:
  \`agent list ${WT_BUNDLE}\` — list live agents in this task
  \`agent <peer-id> message '...'\` — coordinate directly with another agent (e.g. to deconflict a file you both need)

# Discipline

- Stay in your lane (your role). Don't pick up adjacent work without asking via \`[QUESTION]\`.
- Coordinate file conflicts with peers via \`agent <peer-id> message\` before stepping on each other.
- Update BUNDLE.md's **Status (live)** and **Notes & scratchpad** as you progress — the orchestrator and other agents read it.
- Coordinate with other tasks only through merged main. Never reach into \`../other-task/...\`.
- If you have no initial task, wait for one. Don't start work until directed.
PROMPT

if [ -n "$INITIAL_TASK" ]; then
  INITIAL_MESSAGE="[MESSAGE] (From Orchestrator Agent) ${INITIAL_TASK}"
  exec claude \
    --permission-mode bypassPermissions \
    --session-id "$SESSION_ID" \
    --append-system-prompt "$SYSTEM_PROMPT" \
    "$INITIAL_MESSAGE"
else
  exec claude \
    --permission-mode bypassPermissions \
    --session-id "$SESSION_ID" \
    --append-system-prompt "$SYSTEM_PROMPT"
fi
